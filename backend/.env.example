# AgentForge Backend — Environment Variables
# Copy this file to .env and fill in values before running.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_generate_a_long_random_string_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentforge.db

# ─── Ollama / Local LLM ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180
MAX_CONCURRENT_LLM_REQUESTS=1

# ─── Workflow ─────────────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
WORKSPACE_BASE_DIR=../workspace/projects

# ─── CORS (comma-separated origins) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Observability ────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=30
