# AgentForge Backend — Environment Variables
# Copy this file to .env and fill in values before running.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_generate_a_long_random_string_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentforge.db

# ─── Ollama / Local LLM ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180
MAX_CONCURRENT_LLM_REQUESTS=1

# ─── Workflow ─────────────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
WORKSPACE_BASE_DIR=../workspace/projects

# ─── CORS (comma-separated origins) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Observability ────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=30

# ─── Free Developer Services Integrations ────────────────────────────────────
# All external integrations are optional. AgentForge runs 100% locally if omitted.

# 1. GitHub & GitHub Actions (Free tier: Unlimited public repos, 2000 CI mins/mo)
GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DEFAULT_REPO=

# 2. Security Scanners (Free tier: Open-source CLI binaries)
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
TRIVY_ENABLED=true

# 3. OpenObserve Log Ingestion (Free tier: 0.5 GB/day cloud or unlimited self-hosted)
OPENOBSERVE_ENABLED=false
OPENOBSERVE_ENDPOINT=http://localhost:5080
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=
OPENOBSERVE_STREAM=agentforge_events

# 4. Bugsink Error Reporting (Free tier: Self-hosted Sentry-compatible or free tier)
BUGSINK_ENABLED=false
BUGSINK_DSN=

# 5. Better Stack Uptime Monitoring (Free tier: 10 monitors, 3 min checks)
BETTERSTACK_ENABLED=false
BETTERSTACK_HEARTBEAT_URL=
BETTERSTACK_API_TOKEN=

# 6. Cloudflare Pages & Tunnel (Free tier: Unlimited Pages, 50 free tunnels)
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# 7. Backblaze B2 S3 Storage (Free tier: 10 GB free storage, 1 GB/day download)
B2_ENABLED=false
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=

# 8. Authentication & RBAC (Optional JWT Role-Based Access Control)
AUTH_ENABLED=false
AUTH_JWT_SECRET=agentforge-insecure-local-jwt-secret-key-32chars
